<div class="admin-main">
    <a href="/admin/applications" class="back-link mb-3 d-inline-block">← Back to applications</a>

    <div class="profile-card d-flex align-items-center gap-3 mb-4">
        <img src="<%= application.photo_url %>" alt="<%= application.dog_name %>" class="profile-thumb" />
        <div class="flex-grow-1">
            <h4 class="mb-1"><%= application.dog_name %></h4>
            <div>Application from <%= application.first_name %> <%= application.last_name %></div>
            <small class="text-muted">submitted <%= new Date(application.submitted_at).toLocaleDateString('en-GB') %></small>
        </div>
        <span class="badge-status badge-<%= application.status %>">
            <%= capitaliseFirst(application.status.replace('_', ' ')) %>
        </span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="profile-card h-100">
                <h5>Adopter Summary</h5>
                <div class="row">
                    <div class="col-6">
                        <div class="summary-label">Home type</div>
                        <div class="summary-value"><%= capitaliseFirst(adopter.home_type) %></div>
                        <div class="summary-label">Current pets</div>
                        <div class="summary-value"><%= adopter.current_pets ? petCountSummary(adopter.current_pet_count, adopter.current_pet_type): 'None' %></div>
                        <div class="summary-label">Experience</div>
                        <div class="summary-value"><%= adopter.first_time_owner ? 'First-time owner' : 'Experienced' %></div>
                    </div>
                    <div class="col-6">
                        <div class="summary-label">Outdoor space</div>
                        <div class="summary-value"><%= capitaliseFirst(adopter.outdoor_space) %></div>
                        <div class="summary-label">Children</div>
                        <div class="summary-value"><%= capitaliseFirst(adopter.children) ? childrenAgeLabel(adopter.youngest_child_age) : 'None' %></div>
                        <div class="summary-label">Activity Level</div>
                        <div class="summary-value"><%= capitaliseFirst(adopter.activity_level) %></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="profile-card h-100">
                <% if (match) { %>
                    <div class="d-flex justify-content-between align-items-start">
                        <h5>Match Details</h5>
                        <span class="match-score"><%= Math.round(match.overall_score * 100) %>%</span>
                    </div>
                    <p><%= match.explanation %></p>
                    <% match.warnings.forEach(warning => { %>
                        <span class="warning-flag"><%= warning %></span>
                    <% }); %>
                <% } else { %>
                    <h5>Match Details</h5>
                    <p class="text-muted mb-0">No match data available for this application</p>
                <% } %>
            </div>
        </div>
    </div>

    <% if (missing.length > 0) { %>
        <div class="approval-blocked mb-4">
            <strong>Cannot approve yet.</strong> Missing required visits: 
            <%= missing.map(m => m.replace('_', ' ')).join(', ') %>
        </div>
    <% } %>

    <div class="profile-card mb-4">
    <h5>Progress</h5>
    <% 
        const requiredTypes = ['initial_meet', 'home_check']
        if (adopter.current_pets === true) requiredTypes.push('pet_introduction')
        const completedCount = bookings.filter(b => b.status === 'completed' && requiredTypes.includes(b.booking_type)).length
    %>
    <div class="progress-steps">
        <div class="progress-step">
            <div class="step-icon step-complete">✓</div>
            <div class="step-label">Submitted</div>
        </div>
        <div class="progress-step">
            <div class="step-icon <%= application.readiness_checklist ? 'step-complete' : 'step-incomplete' %>">
                <%= application.readiness_checklist ? '✓' : '' %>
            </div>
            <div class="step-label">Checklist</div>
        </div>
        <div class="progress-step">
            <div class="step-icon step-count"><%= completedCount %>/<%= requiredTypes.length %></div>
            <div class="step-label">Visits</div>
        </div>
        <div class="progress-step">
            <div class="step-icon step-decision">🏁</div>
            <div class="step-label">Decision</div>
        </div>
    </div>

    <div class="row mt-4">
        <% const typeLabels = {
            initial_meet: 'Kennel meet',
            home_check: 'Home Visit',
            pet_introduction: 'Pet introduction'
        } %>
        <% requiredTypes.forEach(type => { %>
            <% const booking = bookings.find(b => b.booking_type === type) %>
            <div class="col-md-4">
                <div class="visit-label"><%= typeLabels[type] %></div>
                <% if (booking && booking.status === 'completed') { %>
                    <div class="visit-status visit-complete">Completed <%= new Date(booking.slot).toLocaleDateString('en-GB') %></div>
                <% } else { %>
                    <div class="visit-status visit-incomplete">Incomplete</div>
                <% } %>
            </div>
        <% }); %>
    </div>
</div>

    <div class="d-flex align-items-center gap-3">
    <% if (application.status === 'submitted') { %>
        <form action="/admin/applications/<%= application.application_id %>/review" method="POST">
            <button type="submit" class="btn btn-review">Move to Under Review</button>
        </form>
    <% } %>

    <% if (application.status === 'under_review') { %>
        <form action="/admin/applications/<%= application.application_id %>/approve" method="POST">
            <button type="submit" class="btn btn-approve">Approve</button>
        </form>
        <form action="/admin/applications/<%= application.application_id %>/reject" method="POST">
            <button type="submit" class="btn btn-reject">Reject</button>
        </form>
    <% } %>
</div>
</div>