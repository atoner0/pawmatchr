<div class="container mt-5">
    <div class="alert alert-danger">
        <h4 class="alert-heading">Error</h4>
        <p><%= message %></p>
    </div>
    <button id="go-back" class="btn-secondary">Back</button>
</div>

<script>
    document.getElementById("go-back").addEventListener("click", () => {
        history.back();
    })
</script>