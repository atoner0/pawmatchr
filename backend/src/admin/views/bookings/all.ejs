<div class="bookings-stats">
    <div class="stat-card">
        <h2><%= stats.total %></h2>
        <p>Total bookings</p>
    </div>
    <div class="stat-card">
        <h2><%= stats.initial_meet %></h2>
        <p>Kennel meets</p>
    </div>
    <div class="stat-card">
        <h2><%= stats.home_check %></h2>
        <p>Home visits</p>
    </div>
    <div class="stat-card">
        <h2><%= stats.pet_introduction %></h2>
        <p>Pet introductions</p>
    </div>
</div>

<div class="upcoming-visits-card">
    <h4>Upcoming visits</h4>
    <% if (upcoming.length === 0) { %>
        <p class="text-muted mb-0">No upcoming visits.</p>
    <% } else { %>
        <% upcoming.forEach(b => { %>
            <a href="/admin/bookings/<%= b.booking_id %>" class="upcoming-visit-item">
                <strong><%= capitaliseFirst(b.booking_type.replace('_', ' ')) %> – <%= b.dog_name %></strong><br>
                <span><%= b.first_name %> <%= b.last_name %> — <%= new Date(b.slot).toLocaleString() %></span>
                <% if (b.booking_type === 'pet_introduction') { %>
                    <br><small>Guidance read: <%= b.multi_pet_guidance ? 'Yes' : 'No' %></small>
                <% } %>
            </a>
        <% }) %>
    <% } %>
</div>

<div class="applications-toolbar">
    <label for="statusFilter" class="visually-hidden">Select Status</label>
    <select id="statusFilter" class="btn btn-filter-search">
        <option value="">All Statuses</option>
        <option value="booked">Booked</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
    </select>
    <label for="visitFilter" class="visually-hidden">Select Visit Type</label>
    <select id="visitFilter" class="btn btn-filter-search">
        <option value="">All Types</option>
        <option value="initial_meet">Initial Meet</option>
        <option value="home_check">Home Check</option>
        <option value="pet_introduction">Pet Introduction</option>
    </select>
    <label for="searchInput" class="visually-hidden">Search adopter or dog...</label>
    <input type="text" id="searchInput" class="btn btn-filter-search" placeholder="Search adopter or dog..." />
</div>

<h4>All bookings</h4>
<table class="table bookings-table" id="bookingsTable">
    <thead>
        <tr>
            <th>Date/Time</th>
            <th>Dog</th>
            <th>Adopter</th>
            <th>Visit Type</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        <% bookings.forEach(b => { %>
            <tr data-status="<%= b.status %>" data-visit="<%= b.booking_type %>" data-search="<%= (b.first_name + ' ' + b.last_name + ' ' + b.dog_name).toLowerCase() %>">
                <td><a href="/admin/bookings/<%= b.booking_id %>"><%= new Date(b.slot).toLocaleString() %></a></td>
                <td><%= b.dog_name %></td>
                <td><%= b.first_name %> <%= b.last_name %></td>
                <td><span class="badge-booking-type"><%= b.booking_type.replace('_', ' ') %></span></td>
                <td><span class="badge-status badge-<%= b.status %>"><%= capitaliseFirst(b.status) %></span></td>
            </tr>
        <% }) %>
    </tbody>
</table>

<script>
    const statusFilter = document.getElementById('statusFilter')
    const visitFilter = document.getElementById('visitFilter')
    const searchInput = document.getElementById('searchInput')
    const rows = document.querySelectorAll('#bookingsTable tbody tr')

    function applyFilters() {
        const status = statusFilter.value
        const visit = visitFilter.value
        const search = searchInput.value.toLowerCase()

        rows.forEach(row => {
            const matchesStatus = !status || row.dataset.status === status
            const matchesVisit = !visit || row.dataset.visit === visit
            const matchesSearch = !search || row.dataset.search.includes(search)
            row.style.display = (matchesStatus && matchesVisit && matchesSearch) ? '' : 'none'
        })
    }

    statusFilter.addEventListener('change', applyFilters)
    visitFilter.addEventListener('change', applyFilters)
    searchInput.addEventListener('input', applyFilters)
</script>