<div class="container mt-4">
    <a href="/admin/bookings" class="back-link">&larr; Back to bookings</a>

    <h1>Booking Details</h1>

    <div class="profile-card mt-3">
        <p><span class="summary-label">Visit Type</span><br>
        <span class="summary-value"><%= capitaliseFirst(booking.booking_type.replace('_', ' ')) %></span></p>

        <p><span class="summary-label">Date/Time</span><br>
        <span class="summary-value"><%= new Date(booking.slot).toLocaleString() %></span></p>

        <p><span class="summary-label">Dog</span><br>
        <span class="summary-value"><%= application.dog_name %></span></p>

        <p><span class="summary-label">Adopter</span><br>
        <span class="summary-value"><%= adopter.first_name %> <%= adopter.last_name %></span></p>

        <p><span class="summary-label">Status</span><br>
        <span class="badge-status badge-<%= booking.status %>"><%= capitaliseFirst(booking.status) %></span></p>

        <% if (booking.booking_type === 'pet_introduction') { %>
            <p><span class="summary-label">Multi-pet guidance read</span><br>
            <span class="summary-value"><%= booking.multi_pet_guidance ? 'Yes' : 'No' %></span></p>
        <% } %>
    </div>

    <% if (booking.status === 'booked') { %>
        <div class="mt-3 justify-content-center d-flex gap-2">
            <form method="POST" action="/admin/bookings/<%= booking.booking_id %>/complete" class="d-inline">
                <button type="submit" class="btn-approve">Mark Complete</button>
            </form>
            <form method="POST" action="/admin/bookings/<%= booking.booking_id %>/cancel" class="d-inline" onsubmit="return confirm('Cancel this booking?');">
                <button type="submit" class="btn-reject">Cancel Booking</button>
            </form>
        </div>
    <% } %>
</div>