<div class="container mt-4">
    <div class="bookings-stats">
        <div class="stat-card">
            <h2><%= stats.dogs_in_shelter %></h2>
            <p>Dogs in shelter</p>
        </div>
        <div class="stat-card">
            <h2><%= stats.current_applications %></h2>
            <p>Current Applications</p>
        </div>
        <div class="stat-card">
            <h2><%= stats.dogs_adopted %></h2>
            <p>Dogs adopted</p>
        </div>
    </div>

    <div class="upcoming-visits-card">
        <h4>Upcoming visits</h4>
        <% if (upcomingVisits.length === 0) { %>
            <p class="text-muted mb-0">No upcoming visits.</p>
        <% } else { %>
            <% upcomingVisits.forEach(b => { %>
                <a href="/admin/bookings/<%= b.booking_id %>" class="upcoming-visit-item">
                    <strong><%= capitaliseFirst(b.booking_type.replace('_', ' ')) %> – <%= b.dog_name %></strong><br>
                    <span><%= b.first_name %> <%= b.last_name %> — <%= new Date(b.slot).toLocaleString() %></span>
                </a>
            <% }) %>
        <% } %>
        <a href="/admin/bookings" class="btn-toolbar-action d-block text-center mt-2">View All</a>
    </div>

    <div class="upcoming-visits-card mt-3">
        <h4>Recent Applications</h4>
        <% if (recentApplications.length === 0) { %>
            <p class="text-muted mb-0">No recent applications.</p>
        <% } else { %>
            <% recentApplications.forEach(app => { %>
                <a href="/admin/applications/<%= app.application_id %>" class="upcoming-visit-item d-flex justify-content-between align-items-center">
                    <span>
                        <strong><%= app.first_name %> <%= app.last_name %> &rarr; <%= app.dog_name %></strong><br>
                        <span class="visit-meta">Submitted <%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString() : 'N/A' %></span>
                    </span>
                    <span class="badge-status badge-<%= app.status %>"><%= app.status %></span>
                </a>
            <% }) %>
        <% } %>
        <a href="/admin/applications" class="btn-toolbar-action d-block text-center mt-2">View All</a>
    </div>
</div>