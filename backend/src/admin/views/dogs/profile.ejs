<a href="/admin/dogs" class="back-link mb03 d-inline-block">&larr; Back to dogs</a>

<div class="row g-4">
    <div class="col-md-5">
        <img src="<%= dog.photo_url || '/images/placeholder-dog.jpg' %>" class="card-img-top" alt="<%= dog.name %>">
    </div>
    <div class="col-md-7">
        <div class="dog-header-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h2 class="dog-name"> <%= dog.name %></h2>
                <span class="badge-available"><%= capitaliseFirst(dog.status) %></span>
            </div>
            <div class="dog-detail-grid">
                <div class="dog-detail-item">
                    <span class="detail-label">Breed</span>
                    <span class="detail-value"><%= dog.breed %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Age</span>
                    <span class="detail-value"><%= ageLabel(dog.age) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.gender) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Size</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.size) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Colour</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.colour.join(', ')) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Coat Length</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.coat_length) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Coat Type</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.coat_type) %></span>
                </div>
                <div class="dog-detail-item">
                    <span class="detail-label">Shedding Level</span>
                    <span class="detail-value"><%= capitaliseFirst(dog.shedding_level) %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="description-card mt-4">
    <p class="mb-0"><%= dog.description %></p>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-4">
        <div class="info-card">
            <h4 class="info-card-title">Compatibility</h4>
            <div class="info-row">
                <span class="info-label">Dogs</span>
                <span class="info-value <%= dog.good_with_dogs === 'unknown' ? 'value-flag' : '' %>"><%= capitaliseFirst(dog.good_with_dogs) %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Cats</span>
                <span class="info-value <%= dog.good_with_cats === 'unknown' ? 'value-flag' : '' %>"><%= capitaliseFirst(dog.good_with_cats) %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Children</span>
                <span class="info-value <%= dog.good_with_children === 'unknown' ? 'value-flag' : '' %>"><%= capitaliseFirst(dog.good_with_children) %></span>
            </div>
            <% if (dog.good_with_children === 'yes') { %>
                <div class="info-row">
                    <span class="info-label">Children Age</span>
                    <span class="info-value <%= dog.children_age === 'unknown' ? 'value-flag' : '' %>"><%= childrenAgeLabel(dog.children_age) %></span>
                </div>
            <% } %>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card">
            <h4 class="info-card-title">Routine</h4>
            <div class="info-row">
                <span class="info-label">Hours Alone</span>
                <span class="info-value"><%= aloneToleranceLabel(dog.alone_tolerance) %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Activity Level</span>
                <span class="info-value"><%= capitaliseFirst(dog.activity_level) %></span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card">
            <h4 class="info-card-title">Training</h4>
            <div class="info-row">
                <span class="info-label">Amount Needed</span>
                <span class="info-value"><%= trainingLevelLabel(dog.training_level)%></span>
            </div>
        </div>
    </div>
</div>
<div class="flags-card mt-4">
    <div class="row g-4">
        <div class="col-md-4 text-center">
            <h5 class="flags-title">Medical Issues</h5>
            <div class="flag-pills">
                <% dog.medical_issues.forEach(issue => { %>
                    <span class="flag-pill"><%= capitaliseFirst(issue) %></span>
                <% }) %>
            </div>
            <p class="flag-notes"><%= dog.medical_notes || 'No further notes' %></p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="flags-title">Behavioural Flags</h5>
            <div class="flag-pills">
                <% dog.behavioural_flags.forEach(flag => { %>
                    <span class="flag-pill"><%= capitaliseFirst(flag) %></span>
                <% }) %>
            </div>
            <p class="flag-notes"><%= dog.behavioural_notes || 'No further notes' %></p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="flags-title">Known Triggers</h5>
            <div class="flag-pills">
                <% dog.known_triggers.forEach(trigger => { %>
                    <span class="flag-pill"><%= capitaliseFirst(trigger) %></span>
                <% }) %>
            </div>
            <p class="flag-notes"><%= dog.trigger_notes || 'No further notes' %></p>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center gap-3 mt-4 mb-4">
    <a href="/admin/dogs/<%= dog.dog_id %>/edit" class="btn-edit">Edit</a>
    <form action="/admin/dogs/<%= dog.dog_id %>/delete" method="POST">
        <button type="submit" class="btn-delete">Delete</button>
    </form>
</div>


