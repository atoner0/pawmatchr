<div class="container mt-4">
    <h1><%= title %></h1>
    <%- include('form', { 
        formData: formData, 
        errors: errors || [], 
        actionUrl: `/admin/availability/${slot.availability_id}/edit` 
    }) %>
</div>

<% if (availability_id) { %>
    <form method="POST" action="/admin/availability/<%= availability_id %>/delete" onsubmit="return confirm('Delete this slot?');">
        <button type="submit" class="btn btn-danger">Delete Slot</button>
    </form>
<% } %>